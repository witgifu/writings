{% if noteProps %}
<dl>
  {% if noteProps.warnings %}
  <dt>Warnings</dt>
  <dd>{{ noteProps.warnings }}</dd>
  {% endif %}
  {% if noteProps.rating %}
  <dt>Rating</dt>
  <dd>{{ noteProps.rating }}</dd>
  {% endif %}
  {% if noteProps.categories %}
  <dt>Categories</dt>
  <dd>{{ noteProps.categories }}</dd>
  {% endif %}
</dl>
{% endif %}
